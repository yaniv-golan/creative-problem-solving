#!/usr/bin/env bash
# cps — run this plugin's pipeline scripts without resolving a path.
#
#   cps verify_pipeline "$BASE/$RUN/_work"
#   cps shard_candidates "$BASE/$RUN/_work" --probe 60
#   cps --where                      # print the plugin root this resolved to
#
# WHY THIS EXISTS. Every script here is otherwise called as
# `python3 "$CPS/scripts/<name>.py"`, and `$CPS` costs a 196-line resolver in
# references/pipeline.md because the path the model read the instructions at is a FILE-TOOL path
# while the scripts are run by the SHELL, and on some hosts those are different filesystem
# namespaces. Claude Code puts <plugin root>/bin on the Bash tool's PATH, built for that shell
# rather than inherited -- so a bare `cps` is looked up by the shell, in the shell's own
# namespace, and no path crosses the boundary at all. Measured present for INSTALLED plugins on
# plain CLI, Cowork host-loop and Cowork cloud, each with a different path shape.
#
# NOT universal, and the counter-case is the lane this was built for: a peer measured a
# harness-staged LOCAL plugin whose bin/ was absent from PATH under host-loop while present under
# container. So treat PATH as an optimisation that usually fires, never as the mechanism. That is
# why Step 0 verifies `cps --where` against the sentinel and falls through to the search rather
# than depending on this.
#
# The resolver stays as the fallback. A PATH entry is advertised whether or not the directory
# exists, a path carrying shell metacharacters is dropped silently, and the client version that
# added bare-command lookup is not established -- so pipeline.md must keep working when
# `command -v cps` finds nothing.
#
# DO NOT rename this after a CLI declared in plugin.json's `clis` map. Under Cowork's org-remote
# lane that map makes the runtime materialise <plugin root>/bin/<key> itself, on its own
# schedule. This plugin declares no `clis`, so `cps` does not collide; keep it that way.

set -euo pipefail

# ${BASH_SOURCE[0]} rather than $0: unaffected by a caller that rewrites argv. This script is meant
# to be EXECUTED, not sourced -- it calls `exit` and sets `-euo pipefail`, both of which would hit
# the caller's own shell.
#
# RESOLVE SYMLINKS FIRST. BASH_SOURCE holds the path used to invoke, not the physical file, so
# `ln -s <plugin>/bin/cps ~/bin/cps` -- the single most likely thing anyone does with a file called
# cps -- made ROOT the symlink's grandparent. Measured: --where printed the wrong tree and --list
# printed nothing at all, exit 0. The mount is read-only under Cowork, so this directory can be
# read and executed but never written to: no caching, no self-modification.
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
ROOT="$(cd -P "$(dirname "$src")/.." && pwd)"

# Entry points only. A module that is imported rather than run has no `main` guard, so ask the
# file rather than maintaining a denylist here that nothing checks against scripts/.
list_scripts() {
  for f in "$ROOT"/scripts/*.py; do
    [ -e "$f" ] || continue
    grep -q '^if __name__ ==' "$f" || continue
    basename "$f" .py
  done
}

usage() {
  cat <<USAGE
cps — run a creative-problem-solving pipeline script.

Usage:
  cps <script> [args...]     run scripts/<script>.py (the .py is optional)
  cps --where                print the resolved plugin root
  cps --list                 list the scripts available
  cps --help

Exit codes:
  0    the script succeeded
  1    the script refused -- read its message; it names the remedy
  78   python3 present but too old (3.8+ required)
  127  python3 not found, or no such script

The script's own exit code is passed through unchanged, so a refusal here means what it
means when the script is called directly.
USAGE
}

# NO ARGUMENTS is a person typing `cps`. An EMPTY FIRST ARGUMENT is a variable that did not
# expand, and the two want opposite answers. Grouped together, `cps typo` exited 127 while
# `cps "$UNSET"` printed usage and exited 0 -- the near-miss loud, the likelier programmatic
# failure silent, which inverts the exit-code table above. A pipeline step that does nothing and
# reports success is the failure this whole plugin exists to make impossible. Tell them apart by
# argument COUNT, never by value.
if [ "$#" -eq 0 ]; then usage; exit 0; fi
if [ -z "$1" ]; then
  echo "cps: empty script name — a variable that did not expand?" >&2
  usage >&2
  exit 127
fi

case "$1" in
  -h|--help)    usage; exit 0 ;;
  --where)      printf '%s\n' "$ROOT"; exit 0 ;;
  --list)       list_scripts; exit 0 ;;
esac

if ! command -v python3 >/dev/null 2>&1; then
  echo "cps: python3 not found on \$PATH." >&2
  echo "  The pipeline can still run without the scripts -- take the scriptless fallback in" >&2
  echo "  SKILL.md Phase 1 and say in one line which checks the run lost." >&2
  exit 127
fi

# A version too old fails inside a script with a syntax or import error, several frames deep,
# which reads as a broken plugin rather than a broken interpreter. Say it here instead.
if ! python3 -c 'import sys; sys.exit(0 if sys.version_info >= (3, 8) else 1)'; then
  echo "cps: python3 3.8+ required (found $(python3 -c 'import sys; print("%d.%d" % sys.version_info[:2])'))." >&2
  exit 78
fi

name="${1%.py}"; shift

# A script NAME, never a path. Nothing legitimate needs a slash here, and interpolating one
# straight into "$ROOT/scripts/$name.py" let `cps ../../elsewhere/x` execute a file outside the
# plugin. Not a privilege boundary -- the caller already has a shell -- but it means the argument
# can come from anywhere without turning into a way to run arbitrary files by relative path.
case "$name" in
  */*|.*)
    echo "cps: '$name' is not a script name — pass a bare name, not a path." >&2
    exit 127 ;;
esac

target="$ROOT/scripts/$name.py"
if [ ! -f "$target" ]; then
  echo "cps: no such script '$name'. Available:" >&2
  list_scripts | sed 's/^/  /' >&2
  exit 127
fi

exec python3 "$target" "$@"
